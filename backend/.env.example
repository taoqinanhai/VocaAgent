# ========== 数据库 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=vocaagent

# ========== 统一 API Key（所有 Agent 共用 1 个 Key）==========
API_KEY=sk-your-api-key

# ========== Agent A：简历解析 ==========
APP_ID_A=your-app-id-a

# ========== Agent B：岗位匹配 ==========
APP_ID_B=your-app-id-b

# ========== Agent C：岗位画像（按需触发，单岗位分析）==========
APP_ID_C=your-app-id-c

# ========== Agent D：报告生成 ==========
APP_ID_D=your-app-id-d

# ========== Agent E：虚拟行业大佬 1v1 访谈 ==========
APP_ID_E=your-app-id-e

# ========== 客服（暂时占位，后续配置）==========
# API_KEY1=
# APP_ID1=

# ========== 知识库 ID（后续新建后填入）==========
KNOWLEDGE_BASE_IDS=
# DASHSCOPE_BASE_URL=  # 如需使用私网调用，请取消注释并填入实际的私网终端节点地址
